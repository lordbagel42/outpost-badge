     // todo if this is too big we can do away with it and access the patch directly
     whd_vpatch_numbers = (const uint16_t *) W_CacheLumpName("P_START", PU_STATIC);
+    RDBG("InitSpriteLumps: vpatch_numbers=%p; P_START len=%d expect=%d", (const void *)whd_vpatch_numbers, (int)W_LumpLength(W_GetNumForName("P_START")), (int)(NUM_VPATCHES * 2));
